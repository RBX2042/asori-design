# ElevenLabs API-key (Dashboard -> Profile -> API keys). Nooit in de frontend zetten.
ELEVENLABS_API_KEY=

# Standaard voice ID dat gebruikt wordt als de frontend er geen meestuurt.
# Kies een stem via https://elevenlabs.io/app/voice-library of GET /api/voices hieronder.
ELEVEN_VOICE_ID=

# Origin die deze server mag aanroepen, bv. https://<jouw-gebruiker>.github.io
ALLOWED_ORIGIN=*

PORT=8787
